# =============================================================================
# Exvorta Web Engine — Environment Variables Specification
# =============================================================================
# Copy this template to .env or configure in Vercel Project Settings.
# Values marked REQUIRED will halt production builds/boots if absent.
# Values marked OPTIONAL degrade gracefully to fallbacks.
# NEVER commit real credentials to git.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE & DATABASE (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Used by Payload CMS to encrypt sessions, tokens, and revalidation
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=your-secure-32-char-payload-secret

# [REQUIRED] Pooled PostgreSQL connection string (Neon / Supabase / Postgres)
DATABASE_URI=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# [REQUIRED FOR MIGRATIONS] Direct unpooled connection string (used by payload migrate)
DATABASE_URI_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# [REQUIRED] Recipient email for internal inquiries and lead alerts.
# Must be a real email address (dummy placeholders like admin@yourdomain.com will throw in production).
ADMIN_EMAIL=operations@exvorta.com


# ─────────────────────────────────────────────────────────────────────────────
# 2. EMAIL & LEAD DISPATCH (REQUIRED IN PRODUCTION IF EMAILS ENABLED)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED IF EMAILS ENABLED] Resend API key for automated lead & RFQ emails
# https://resend.com/api-keys
RESEND_API_KEY=re_your_verified_resend_api_key

# [OPTIONAL] Verified sending domain configured in Resend (default: exvorta.com)
EMAIL_FROM_DOMAIN=exvorta.com

# [OPTIONAL] Toggle lead notification emails (default: true in production)
ENABLE_LEAD_EMAILS=true

# [OPTIONAL] Toggle RFQ notification emails (default: true in production)
ENABLE_RFQ_EMAILS=true


# ─────────────────────────────────────────────────────────────────────────────
# 3. BOT PROTECTION / TURNSTILE (REQUIRED IN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED IN PRODUCTION] Cloudflare Turnstile Public Site Key
# https://dash.cloudflare.com → Turnstile
# Cloudflare Test Sitekey (Always Passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...

# [REQUIRED IN PRODUCTION] Cloudflare Turnstile Secret Key (server-side verification)
# Cloudflare Test Secret Key (Always Passes): 1x0000000000000000000000000000000AA
# Cloudflare Test Secret Key (Always Blocks): 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# [OPTIONAL / LOCAL TESTING ONLY] Set to 'true' to allow Cloudflare dummy testing secret in production-mode test runs
# LOCAL TESTING ONLY — never set in real deployments
ALLOW_TEST_TURNSTILE_KEY=false

# [OPTIONAL / DEV ONLY] Set to 'true' to bypass verification in local development only
SKIP_TURNSTILE_IN_DEV=true


# ─────────────────────────────────────────────────────────────────────────────
# 4. MEDIA STORAGE / CLOUDINARY (OPTIONAL / INTEGRATION)
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Cloudinary credentials for media upload library (if omitted, local/placeholder mode runs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ─────────────────────────────────────────────────────────────────────────────
# 5. APPLICATION URL & MISCELLANEOUS (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Canonical public site URL (default: http://localhost:3000 in dev, https://exvorta.com in prod)
NEXT_PUBLIC_SERVER_URL=https://exvorta.com

# [OPTIONAL] Title suffix for admin panel
NEXT_PUBLIC_ADMIN_TITLE_SUFFIX="- Exvorta Agency Engine"

# [OPTIONAL / DEV ONLY] Webhook URL for waitlist integrations
WAITLIST_WEBHOOK_URL=
