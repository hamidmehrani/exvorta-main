{
  "name": "exvorta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "generate:importmap": "NODE_OPTIONS=\"--no-deprecation --import tsx\" node ./node_modules/payload/bin.js generate:importmap",
    "build": "pnpm generate:importmap && next build",
    "postinstall": "node scripts/fix-payload-loadenv.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "payload": "NODE_OPTIONS=\"--no-deprecation --import tsx\" node ./node_modules/payload/bin.js",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.2",
    "@neondatabase/serverless": "^0.10.4",
    "@next/third-parties": "15.4.11",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-vercel-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@react-three/fiber": "^9.8.2",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "glob": "^13.0.6",
    "graphql": "^16.14.1",
    "gsap": "^3.15.0",
    "https-proxy-agent": "^9.1.0",
    "lenis": "^1.3.26",
    "next": "15.4.11",
    "payload": "3.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "15.4.11",
    "@next/env": "15.4.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.4.11",
    "lighthouse": "^12.8.2",
    "linkinator": "^7.6.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
